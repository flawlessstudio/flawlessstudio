{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flawlessstudio/.github/blob/main/.claude/docs/schemas/crawl_config.schema.json",
  "title": "CrawlConfig",
  "description": "Configuration and final coverage report for a mapping crawl run",
  "type": "object",
  "required": ["run_id", "schema_version", "started_at", "target_ecosystem"],
  "properties": {
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "target_ecosystem": {
      "type": "string",
      "description": "Primary ecosystem being mapped",
      "examples": ["claudemarketplaces.com", "multica-ai", "flawlessstudio"]
    },
    "flags": {
      "type": "object",
      "properties": {
        "SITE_BLOCKED": { "type": "boolean", "default": false },
        "GITHUB_FIRST": { "type": "boolean", "default": false }
      }
    },
    "seed_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of seed nodes discovered in Phase 0"
    },
    "total_nodes_processed": {
      "type": "integer",
      "minimum": 0
    },
    "total_skills_found": {
      "type": "integer",
      "minimum": 0
    },
    "total_mcps_found": {
      "type": "integer",
      "minimum": 0
    },
    "total_authors_found": {
      "type": "integer",
      "minimum": 0
    },
    "nodes_by_status": {
      "type": "object",
      "properties": {
        "DONE": { "type": "integer" },
        "BLOCKED": { "type": "integer" },
        "ERROR": { "type": "integer" },
        "PENDING": { "type": "integer" }
      }
    },
    "coverage_by_phase": {
      "type": "object",
      "properties": {
        "phase_0": { "type": "object", "properties": { "nodes": { "type": "integer" }, "duration_ms": { "type": "integer" } } },
        "phase_1": { "type": "object", "properties": { "nodes": { "type": "integer" }, "duration_ms": { "type": "integer" } } },
        "phase_2": { "type": "object", "properties": { "nodes": { "type": "integer" }, "duration_ms": { "type": "integer" } } },
        "phase_3": { "type": "object", "properties": { "nodes": { "type": "integer" }, "duration_ms": { "type": "integer" } } },
        "phase_4": { "type": "object", "properties": { "nodes": { "type": "integer" }, "duration_ms": { "type": "integer" } } },
        "phase_5": { "type": "object", "properties": { "nodes": { "type": "integer" }, "duration_ms": { "type": "integer" } } },
        "phase_6": { "type": "object", "properties": { "nodes": { "type": "integer" }, "duration_ms": { "type": "integer" } } }
      }
    },
    "bypass_tier_usage": {
      "type": "object",
      "description": "Count of times each bypass tier was used",
      "properties": {
        "tier_1_wayback": { "type": "integer" },
        "tier_2_archive_ph": { "type": "integer" },
        "tier_3_google_cache": { "type": "integer" },
        "tier_4_github_raw": { "type": "integer" },
        "tier_5_commoncrawl": { "type": "integer" },
        "tier_6_reconstruction": { "type": "integer" },
        "tier_7_pattern": { "type": "integer" },
        "permanently_blocked": { "type": "integer" }
      }
    },
    "average_completeness_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "closure_criteria_met": {
      "type": "object",
      "description": "Status of all 8 closure criteria at run end",
      "properties": {
        "queue_empty": { "type": "boolean" },
        "no_orphan_authors": { "type": "boolean" },
        "no_unresolved_conflicts": { "type": "boolean" },
        "schema_valid": { "type": "boolean" },
        "mcp_complete": { "type": "boolean" },
        "links_checked": { "type": "boolean" },
        "checkpoint_written": { "type": "boolean" },
        "dry_rounds_met": { "type": "boolean" }
      }
    },
    "converged": {
      "type": "boolean",
      "description": "True when all 8 closure criteria are met"
    },
    "output_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filename", "format", "size_bytes"],
        "properties": {
          "filename": { "type": "string" },
          "format": { "type": "string", "enum": ["json", "ndjson", "markdown"] },
          "size_bytes": { "type": "integer" },
          "record_count": { "type": "integer" }
        }
      }
    }
  },
  "additionalProperties": false
}
